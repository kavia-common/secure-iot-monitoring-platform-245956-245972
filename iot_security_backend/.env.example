# Request the real JWT secret from the user/orchestrator.
# This file documents the expected backend configuration for local demo use.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# These defaults match the MongoDB database container startup and seed scripts.
MONGODB_URL=mongodb://appuser:dbuser123@localhost:5000/myapp?authSource=admin
MONGODB_DB=myapp

# Replace with a real secret supplied through the orchestrator/.env.
JWT_SECRET=replace-with-a-secret-from-orchestrator
JWT_EXPIRES_IN=12h

# For local development, point these to the React app origin.
# In deployed preview environments, set both values to the frontend container URL.
CORS_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000

MOCK_DEVICE_GENERATOR_ENABLED=true
MOCK_DEVICE_GENERATOR_INTERVAL_MS=12000
SUSPICIOUS_WINDOW_SECONDS=120
SUSPICIOUS_EVENT_THRESHOLD=3
