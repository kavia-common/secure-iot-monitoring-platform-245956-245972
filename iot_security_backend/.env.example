# Request the real values for these variables from the user or orchestrator.
# Do not commit secrets in a real environment.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Database connection values must use the database container environment variable names.
MONGODB_URL=mongodb://appuser:dbuser123@localhost:5000/?authSource=admin
MONGODB_DB=myapp

# Request the production-grade JWT secret from the user/orchestrator.
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=12h

# Frontend origin(s) allowed to call the API and connect to Socket.IO.
# Use * only for local/demo usage.
CORS_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000

# Demo data generator controls.
MOCK_DEVICE_GENERATOR_ENABLED=true
MOCK_DEVICE_GENERATOR_INTERVAL_MS=12000

# Suspicious activity detection configuration.
SUSPICIOUS_WINDOW_SECONDS=120
SUSPICIOUS_EVENT_THRESHOLD=3
